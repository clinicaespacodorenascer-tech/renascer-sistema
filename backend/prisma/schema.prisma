// Espaço do Renascer — Sistema de Gestão
// Schema de dados (PostgreSQL via Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  DONO
  ATENDENTE
  PROFISSIONAL
  CLIENTE
  USUARIO_IA // Renascer IA: cadastro público, aberto a qualquer pessoa, não só cliente da clínica
  // Fase 31 — "Setor Financeiro": login próprio pra quem cuida do financeiro da clínica no dia a
  // dia (CAC/ROI de anúncio, imposto, retiradas/pró-labore, repasses das profissionais) sem ser
  // a própria Dona/Dono. Não substitui o Dono — ele continua vendo/podendo fazer tudo isso também.
  FINANCEIRO
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum TurnoSite {
  MANHA
  TARDE
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  REALIZADO
  CANCELADO
  REAGENDADO
  FALTOU
}

enum DuracaoSessao {
  MIN30
  MIN50
}

enum StatusPacote {
  ATIVO
  ENCERRADO
  AGUARDANDO_RENOVACAO
  CANCELADO
}

enum TipoTransacao {
  PACOTE_NOVO
  RENOVACAO
  SESSAO_EXTRA
  OUTRO
}

// Quem ficou com o dinheiro do cliente na hora: a CLINICA (a atendente registrou — cliente
// pagou pra clínica) ou a própria PROFISSIONAL (ela recebeu direto e é ela quem deve repassar
// a parte da Renascer).
enum QuemRecebeu {
  CLINICA
  PROFISSIONAL
}

// Quem registrou a transação no sistema — não é sobre o dinheiro (isso é o QuemRecebeu acima),
// é só pra separar nos painéis do dono o que a atendente fechou (aparece em "a receber hoje")
// do que a própria profissional lançou sozinha (renovação/sessão extra dela mesma).
enum OrigemTransacao {
  ATENDENTE
  PROFISSIONAL
}

enum StatusSuporte {
  ABERTO
  EM_ANDAMENTO
  ESCALADO_GERENCIA
  RESOLVIDO
}

// Situação do cliente na lista de uma profissional: ATIVO é o normal, EXCLUIDO é quando a
// profissional (ou a atendente) marcou que ele não renovou — ele some da lista dela, mas
// continua existindo no sistema pra aparecer na fila de reativação do dono/atendente.
enum SituacaoCliente {
  ATIVO
  EXCLUIDO
}

// Fase 55 — quando a Atendente ou o Dono cadastra um cliente escolhendo a profissional, ele fica
// PENDENTE até ela aceitar na aba "Novos pacientes". ACEITA é quando ela confirma (aí sim entra
// na agenda e vira receita de verdade).
enum StatusSolicitacaoNovoPaciente {
  PENDENTE
  ACEITA
}

// Cada linha do histórico registra um momento importante da vida do cliente no sistema —
// só o dono enxerga essa linha do tempo completa.
enum TipoEventoHistorico {
  ENTROU
  RENOVOU
  EXCLUIDO
  REATIVADO
  TROCOU_PROFISSIONAL
}

// ---------- "MEU DIA" (Fase 30) ----------

// De onde um cliente novo veio — preenchido opcionalmente no cadastro (atendente/profissional) —
// usado pra calcular indicadores reais de marketing (leads por canal, CAC) em vez de deixá-los
// sem nenhum dado.
enum CanalOrigem {
  INSTAGRAM
  FACEBOOK
  GOOGLE
  INDICACAO
  OUTRO
}

enum TipoMovimentoCaixa {
  ENTRADA
  SAIDA
}

enum TipoRegistroMarketing {
  POST
  STORIES
  RESPOSTA
  AVALIACAO
  OUTRO
}

enum TipoRegistroPessoas {
  ALINHAMENTO
  FEEDBACK
  DIFICULDADE
  TREINAMENTO
  OUTRO
}

enum TemaTarefa {
  ANSIEDADE
  DEPRESSAO
  RELACIONAMENTOS
  AUTOESTIMA
  LUTO_MUDANCAS
  SONO
  ESTRESSE
  OUTRO
}

enum HumorDia {
  MUITO_BOM
  BOM
  NEUTRO
  RUIM
  MUITO_RUIM
}

// ---------- USUÁRIO BASE ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  senha         String
  role          Role
  nome          String
  telefone      String?
  cpf           String?
  fotoUrl       String?
  ativo         Boolean  @default(true)
  ultimoAcessoEm DateTime? // atualizado (com limite de 1x/min) a cada request autenticado — usado
                           // pra mostrar "online agora" / "visto há X min" pra quem tem permissão
  // Fase 33 — Secretaria/Supervisão: calculados junto com ultimoAcessoEm (mesmo bloco, sem
  // chamada nova no front). sessaoAtivaDesde é o início da sessão contínua atual (reseta quando
  // fica mais de alguns minutos sem nenhum request); tempoOnlineHojeSegundos é o acumulado de
  // tempo ativo HOJE (zera sozinho quando tempoOnlineHojeData deixa de ser o dia de hoje).
  sessaoAtivaDesde DateTime?
  tempoOnlineHojeSegundos Int @default(0)
  tempoOnlineHojeData DateTime?
  // Renascer IA: quando a pessoa aceitou os avisos/termos no cadastro público (18+, termos de uso,
  // privacidade) — obrigatório antes de liberar a conversa com a IA.
  aceitouTermosIAEm DateTime?
  // Renascer IA: quando a pessoa tocou em "Agora não" na sugestão de sessão — a IA só volta a
  // sugerir depois dessa data (regra do Elismael: não ficar chato sugerindo toda hora).
  sessaoIADispensadaAte DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  profissional  Profissional?
  cliente       Cliente?
  atendente     Atendente?
  dono          Dono?
  financeiro    Financeiro? // Fase 31 — Setor Financeiro

  notificacoes  Notificacao[]
  mensagensEnviadas Mensagem[] @relation("MensagensEnviadas")
  pushSubscriptions PushSubscription[]
  conversasIA   ConversaIA[]
  formularios   Formulario[] // formulários (pesquisas) que esse usuário criou

  @@map("users")
}

model Dono {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mapasMentais MapaMental[] // Fase 32 — Mapas mentais

  @@map("donos")
}

// Fase 32 — Mapas mentais: ferramenta de planejamento pessoal do Dono (estratégias, tarefas,
// ideias pro futuro), em formato de mapa mental com nós que podem ser arrastados. Os nós ficam
// guardados num campo JSON (nodes: [{id, texto, x, y, parentId}]) em vez de virarem uma tabela
// própria, porque a estrutura de cada mapa é livre (qualquer nó pode ter qualquer quantidade de
// filhos) e quem lê/escreve isso sempre é o mapa inteiro de uma vez (não precisa de consulta por
// nó individual no banco). Cada mapa pertence só ao Dono que criou.
model MapaMental {
  id     String @id @default(cuid())
  nome   String
  cor    String @default("#0B5FA8")
  nodes  Json

  donoId String
  dono   Dono   @relation(fields: [donoId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("mapas_mentais")
}

model Atendente {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientesCadastrados Cliente[] @relation("CadastradoPorAtendente")

  @@map("atendentes")
}

// ---------- SETOR FINANCEIRO (Fase 31) ----------
// Login sem agenda/clientes próprios — só o painel financeiro (ver backend/src/routes/
// financeiro.js). Mesma estrutura mínima do Atendente/Dono (não guarda nada extra aqui; o
// trabalho dela fica nos modelos abaixo e reaproveitando MovimentoCaixa/TransacaoFinanceira
// que já existiam).
model Financeiro {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financeiros")
}

// Lançamento diário do Setor Financeiro: quanto foi investido em anúncio, quantos leads chegaram
// no WhatsApp e quantos converteram — alimenta CAC/ROI do painel financeiro. Um registro por dia
// (upsert quando lança de novo o mesmo dia). Gera também um MovimentoCaixa (SAIDA, categoria
// "Anúncio (Setor Financeiro)") pra esse gasto entrar no caixa/lucro do dia normalmente — o id
// fica guardado aqui pra atualizar o mesmo lançamento em vez de duplicar se a pessoa lançar de
// novo o mesmo dia.
model InvestimentoAnuncioDiario {
  id             String    @id @default(cuid())
  data           DateTime  @unique
  investido      Float
  leads          Int
  conversoes     Int       @default(0)
  movimentoCaixaId String? @unique
  criadoPorId    String
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@map("investimentos_anuncio_diario")
}

// "Marcar como pago" do cartão "Pagamento de anúncios de hoje" — um registro por dia+canal.
model PagamentoAnuncioStatus {
  id        String    @id @default(cuid())
  data      DateTime
  canal     String    // "META" | "GOOGLE"
  pago      Boolean   @default(false)
  pagoEm    DateTime?
  pagoPorId String?

  @@unique([data, canal])
  @@map("pagamentos_anuncio_status")
}

// ---------- PROFISSIONAL ----------

model Profissional {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  titulo       String   // ex: "Psicóloga Clínica", "Psicanalista"
  registro     String?  // CRP, quando houver
  bio          String?  @db.Text
  idade        Int?     // idade da profissional, pra atendente conseguir filtrar/indicar melhor
  especialidades String[] @default([]) // "o que atende" / categorias (ex: Ansiedade, Relacionamentos, Autoestima)
  abordagens   String?  // ex: "TCC, Psicanálise"
  percentualRepasse Float @default(50) // % que fica com a profissional (padrão 50/50)
  linkMeet     String?  // link fixo do Google Meet da profissional, usado em todas as sessões dela

  // Fase 62 — site público: liga esta conta ao "card" dela no site institucional
  // (espacodorenascer.com/site), ex: "andrea-santos". Quando preenchido, o popup de agendamento
  // do site busca os horários realmente livres dela (mesma agenda/disponibilidade usada aqui
  // dentro) em vez de perguntar turno genérico. Em branco = esse card do site ainda não está
  // ligado a nenhuma conta real (o popup cai no modo "combinar pelo WhatsApp").
  slugSitePublico String? @unique

  disponibilidades Disponibilidade[]
  clientes         Cliente[]           @relation("ClienteDoProfissional")
  agendamentos     Agendamento[]
  transacoes       TransacaoFinanceira[]
  relatorios       RelatorioCliente[]
  mensagens        MensagemInterna[]    @relation("MensagensDoProfissional")
  tarefasCriadas   Tarefa[]             @relation("TarefasCriadasPeloProfissional")
  solicitacoesNovoPaciente SolicitacaoNovoPaciente[]
  perfilSite       PerfilSiteProfissional?
  rodizioSite      RodizioSiteProfissional[]
  excecoesRodizioSite RodizioSiteExcecao[]

  criadoEm     DateTime @default(now())

  @@map("profissionais")
}

// Fase 75 — "Banco de Oportunidades" teve seu momento; agora é a vez do site institucional parar
// de ser um arquivo estático editado na mão (ver frontend/public/site-assets/app.js, objeto
// PROFISSIONAIS) e passar a ler do banco, com uma tela de edição pro Dono em "Site". 1:1 com
// Profissional — o vínculo público de verdade (pro link funcionar) continua sendo
// Profissional.slugSitePublico, reaproveitado aqui também, pra não ter dois "slugs" conflitando.
model PerfilSiteProfissional {
  id             String       @id @default(cuid())
  profissionalId String       @unique
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  // Esses três podem divergir do cadastro "interno" da profissional (Profissional.titulo/bio) de
  // propósito — o nome/cargo que aparece pro público nem sempre é igual ao do cadastro de dentro
  // do sistema (ex: "Lê Baes" em vez do nome civil completo).
  nomeExibicao  String
  cargoExibicao String
  registro      String?
  // "mulher" | "homem" — alimenta o filtro "Mulheres/Homens" que já existe no site hoje
  // (frontend/public/site-assets/body.html, botões .filter-btn). Null = não entra em nenhum dos
  // dois filtros, mas continua aparecendo em "Todos".
  genero        String?
  bioParagrafos String[] @default([])
  tags          String[] @default([])
  quote         String?
  testemunhos   String[] @default([])
  // Foto própria do site — pode ser diferente da foto de perfil usada dentro do sistema. Mesmo
  // padrão já usado em User.fotoUrl (base64 direto no banco; "fase 2: subir pra storage real" é
  // uma dívida técnica antiga do projeto inteiro, não desta feature específica).
  fotoBase64    String?  @db.Text

  ativo  Boolean @default(true) // false = não aparece no site, sem precisar excluir o cadastro
  ordem  Int     @default(0)    // ordem de exibição na lista (menor primeiro)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("perfis_site_profissionais")
}

// Fase 75-B — rodízio do site: padrão semanal fixo de quem aparece em cada turno (manhã/tarde)
// de cada dia da semana. Quem NUNCA foi colocado em nenhum rodízio continua aparecendo no site
// sempre (comportamento antigo, preservado) — o filtro por dia/turno só vale pra quem o Dono de
// fato colocou numa escala aqui. O site troca de manhã pra tarde sozinho ao meio-dia (horário de
// Brasília) — ver GET /publico/site/profissionais.
model RodizioSiteProfissional {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  diaSemana      DiaSemana
  turno          TurnoSite

  criadoEm DateTime @default(now())

  @@unique([profissionalId, diaSemana, turno])
  @@map("rodizio_site_profissionais")
}

// Tira uma profissional do site só numa data específica (ex: ela avisou que não vai atender
// hoje), sem tocar no padrão semanal de RodizioSiteProfissional — na data seguinte ela volta a
// aparecer normalmente. Vale tanto pra quem está numa escala fixa quanto pra quem nunca foi
// colocada em nenhuma (sempre aparece por padrão): a exceção sempre tira do site na data dela.
model RodizioSiteExcecao {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  data           DateTime     @db.Date

  criadoEm DateTime @default(now())

  @@unique([profissionalId, data])
  @@map("rodizio_site_excecoes")
}

model Disponibilidade {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  diaSemana      DiaSemana
  horaInicio     String       // horário exato que ela atende nesse dia, ex: "08:30"
  horaFim        String?      // legado (não usado mais pra gerar horários — cada linha é um horário exato, não uma faixa)
  ativo          Boolean      @default(true)

  // Quando um cliente fica com esse dia+horário fixo (recorrente, toda semana), ele some da
  // lista de horários livres pra qualquer outro cliente — continua reservado só pra ele até
  // sair (não renovou) ou até a atendente/profissional agendar um novo horário fixo pra ele,
  // que libera este automaticamente.
  ocupadoPorClienteId String?
  ocupadoPorCliente   Cliente?  @relation("ClienteHorarioFixo", fields: [ocupadoPorClienteId], references: [id])
  ocupadoEm           DateTime?

  @@index([profissionalId])
  @@index([ocupadoPorClienteId])
  @@map("disponibilidades")
}

// ---------- CLIENTE ----------

model Cliente {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cpf            String?
  dataNascimento DateTime?

  profissionalAtualId String?
  profissionalAtual   Profissional? @relation("ClienteDoProfissional", fields: [profissionalAtualId], references: [id])

  cadastradoPorId     String?
  cadastradoPor       Atendente? @relation("CadastradoPorAtendente", fields: [cadastradoPorId], references: [id])

  // Contato dedicado pra receber avisos automáticos (pode ser diferente do login)
  notifEmail          String?
  notifTelefone       String?
  // Data prevista de renovação, cadastrada pela atendente/profissional — dispara aviso automático dias antes
  renovarEm             DateTime?
  renovarEmAvisoEnviado Boolean  @default(false)
  // Fase 69 — "liga pra saber como ele está": aviso separado do de cima, dispara ~7 dias ANTES de
  // renovarEm (antes do aviso de "hora de renovar", que continua disparando ~3 dias antes) — pra
  // atendente/dono ligarem e perguntarem como estão indo as sessões, sem ainda falar de renovação/
  // cobrança. Volta pra false sempre que uma nova data de renovarEm é definida, igual o de cima.
  renovarCheckinSemanaEnviado Boolean @default(false)
  // Fase 57 — "Marcar como contatado": quando alguém do Financeiro/Dono já ligou/chamou esse
  // cliente sobre a renovação que está chegando (tela "Clientes pra renovar" novo layout). Fica
  // null de novo sempre que uma nova data de renovarEm é definida (novo ciclo).
  renovarContatadoEm    DateTime?

  // Situação atual (ativo na lista da profissional, ou marcado como "não renovou e saiu") e o
  // WhatsApp exato que ele informou no cadastro — guardado à parte pra nunca se perder, mesmo
  // que o telefone de contato mude depois. É esse número que aparece na fila de reativação.
  situacao         SituacaoCliente @default(ATIVO)
  whatsappCadastro String?

  // De onde esse cliente veio (Fase 30) — opcional, preenchido no cadastro pela atendente. Usado
  // só pra indicador de marketing (leads/novos clientes por canal, CAC) — nunca obrigatório, pra
  // não travar nenhum cadastro antigo nem novo que não souber a origem.
  canalOrigem    CanalOrigem?

  contrato       Contrato?
  pacotes        Pacote[]
  agendamentos   Agendamento[]
  transacoes     TransacaoFinanceira[]
  relatorios     RelatorioCliente[]
  recados        RecadoDiario[]
  checkins       CheckinDiario[]
  tarefasAtribuidas TarefaCliente[]
  tickets        TicketSuporte[]
  mensagens      MensagemInterna[] @relation("MensagensDoCliente")
  historico      HistoricoCliente[]
  horariosFixos  Disponibilidade[] @relation("ClienteHorarioFixo")
  solicitacoesNovoPaciente SolicitacaoNovoPaciente[]

  criadoEm       DateTime @default(now())

  @@index([profissionalAtualId])
  @@index([situacao])
  @@index([canalOrigem])
  @@map("clientes")
}

// Fase 55 — "pedido de novo paciente": criado quando a Atendente ou o Dono cadastra um cliente
// já escolhendo a profissional (eles nunca cadastram direto pra si mesmos, diferente da
// Profissional). O cliente já ganha login na hora, mas só vira paciente de fato dela — com
// pacote, sessões na agenda e lançamento financeiro — quando ela aceita na aba "Novos pacientes".
// Guarda aqui, pendente, tudo que foi combinado no cadastro (pacote, dia/hora fixo, pagamento já
// recebido) pra aplicar tudo de uma vez só no momento do aceite.
model SolicitacaoNovoPaciente {
  id             String       @id @default(cuid())
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  duracao        DuracaoSessao?
  totalSessoes   Int?
  diaSemanaFixo  DiaSemana?
  horaFixa       String?

  valorTotal          Float?
  valorPacoteTotal    Float?  // Fase 59 — valor cheio do pacote, só quando valorTotal acima é um pagamento parcial dele
  tipo                TipoTransacao?
  comprovanteBase64   String?        @db.Text
  comprovanteMimeType String?
  observacao          String?

  criadoPorNome  String   // "foto" de quem cadastrou (atendente ou dono), pra mostrar na tela dela
  criadoPorId    String?

  status         StatusSolicitacaoNovoPaciente @default(PENDENTE)
  criadoEm       DateTime  @default(now())
  respondidoEm   DateTime?

  @@index([profissionalId])
  @@index([clienteId])
  @@index([status])
  @@map("solicitacoes_novo_paciente")
}

// Linha do tempo do cliente (entrou, renovou, foi excluído por não renovar, foi reativado) —
// guarda uma "foto" do nome/whatsapp/pacote no momento do evento, pra continuar legível mesmo
// que o cadastro mude depois. Só o dono enxerga essa lista completa.
model HistoricoCliente {
  id               String              @id @default(cuid())
  clienteId        String
  cliente          Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo             TipoEventoHistorico
  nomeCliente      String
  whatsapp         String?
  pacoteResumo     String?             // ex: "50min - 4 sessão(ões)"
  profissionalNome String?
  motivo           String?
  // Fase 33 — id do login (User) que realizou a ação, quando dá pra saber. Opcional e sem
  // relação (é só uma "foto" do autor, igual aos outros campos daqui) — alimenta a tela de
  // Supervisão de setor (ex.: quantas reativações a Secretaria X fez hoje). Registros antigos
  // (antes da Fase 33) ficam null e não entram em nenhuma conta de "hoje" por atendente.
  realizadoPorId   String?

  criadoEm         DateTime            @default(now())

  @@index([clienteId])
  @@map("historico_clientes")
}

// Contrato de aceite (item 16 do cliente)
model Contrato {
  id            String   @id @default(cuid())
  clienteId     String   @unique
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nomeCompleto  String
  cpf           String
  fotoDocumentoUrl String
  fotoRostoUrl     String?
  versaoContrato   String   @default("1.0")
  aceitoEm         DateTime?
  ip               String?

  @@map("contratos")
}

// ---------- PACOTES / PLANOS ----------
// Planos fixos do Espaço do Renascer (30min: 1/2/4 sessões — 50min: 1/2/4 sessões)

model Pacote {
  id             String        @id @default(cuid())
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  profissionalId String

  duracao        DuracaoSessao
  totalSessoes   Int           // 1, 2 ou 4
  sessoesUsadas  Int           @default(0)
  valorTotal     Float
  status         StatusPacote  @default(ATIVO)

  iniciadoEm     DateTime      @default(now())
  encerradoEm    DateTime?
  avisoRenovacaoEmailEm DateTime? // controla pra não mandar o e-mail de renovação mais de uma vez

  // Pop-up premium de renovação que o cliente vê no painel dele: fica "AMARELO" na penúltima
  // sessão do pacote e "VERMELHO" quando termina todas sem renovar. popupVisualizadoEm marca
  // que ele já viu e fechou (não reaparece até o próximo nível).
  avisoPopupNivel    String?
  popupVisualizadoEm DateTime?

  agendamentos   Agendamento[]

  @@index([clienteId])
  @@index([profissionalId])
  @@index([status])
  @@map("pacotes")
}

// ---------- AGENDA ----------

model Agendamento {
  id             String            @id @default(cuid())
  profissionalId String
  profissional   Profissional      @relation(fields: [profissionalId], references: [id])
  clienteId      String
  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  pacoteId       String?
  pacote         Pacote?           @relation(fields: [pacoteId], references: [id])

  data           DateTime
  diaSemana      DiaSemana
  horaInicio     String
  duracao        DuracaoSessao
  status         StatusAgendamento @default(AGENDADO)

  reagendadoDe   String?           // id do agendamento original, se veio de reagendamento
  motivoCancelamento String?

  // Controle dos lembretes automáticos por e-mail (pra não mandar duas vezes)
  lembrete24hEmailEm DateTime?
  lembrete6hEmailEm  DateTime?
  // Controle do aviso "profissional não iniciou a sessão" (dono/atendente) — evita mandar mais
  // de uma vez pro mesmo agendamento. O "iniciou ou não" em si é lido de chamadaVideo.iniciadaEm.
  avisoNaoIniciadoEnviado Boolean @default(false)
  // Fase 56 — controle do aviso "marque a sessão como feita" (pra PROFISSIONAL, não pro
  // dono/atendente): dispara 1h depois do horário marcado se ela ainda não marcou Realizada/
  // Faltou/Cancelada. Evita mandar mais de uma vez pro mesmo agendamento.
  avisoConcluirSessaoEnviado Boolean @default(false)

  chamadaVideo   ChamadaVideo?

  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt

  @@index([profissionalId])
  @@index([clienteId])
  @@index([data])
  @@index([status])
  @@map("agendamentos")
}

// Videochamada (Daily.co) — registro de duração exata
model ChamadaVideo {
  id             String       @id @default(cuid())
  agendamentoId  String       @unique
  agendamento    Agendamento  @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  provider       String       @default("daily") // "daily" | "jitsi" | etc
  roomUrl        String?
  roomName       String?
  iniciadaEm     DateTime?
  encerradaEm    DateTime?
  duracaoMinutos Int?

  criadoEm       DateTime     @default(now())

  @@map("chamadas_video")
}

// ---------- FINANCEIRO ----------

model TransacaoFinanceira {
  id             String         @id @default(cuid())
  profissionalId String
  profissional   Profissional   @relation(fields: [profissionalId], references: [id])
  clienteId      String?
  cliente        Cliente?       @relation(fields: [clienteId], references: [id])

  tipo           TipoTransacao  @default(OUTRO)
  valorTotal     Float
  valorProfissional Float       // já calculado (percentualRepasse)
  valorRenascer     Float

  // Controle de repasse: quem recebeu o dinheiro do cliente na hora, e se a pendência que
  // sobrou disso já foi resolvida. Só importa de verdade quando recebidoPor = PROFISSIONAL
  // (aí "repassado" fecha o quanto ela devia mandar pra Renascer) — a profissional pode marcar
  // sozinha na aba financeiro dela, ou o dono pode confirmar na aba Repasses.
  recebidoPor    QuemRecebeu    @default(CLINICA)
  // Quem lançou: a atendente (fechou/anexou pagamento de um cliente) ou a própria profissional
  // (registrou uma renovação/sessão extra que ela mesma recebeu). Usado só pra filtrar os
  // painéis do dono — não muda em nada o cálculo do repasse.
  origem         OrigemTransacao @default(PROFISSIONAL)
  repassado      Boolean        @default(false)
  repassadoEm    DateTime?
  repassadoObs   String?

  // Comprovante do REPASSE em si (diferente do comprovante do pagamento do cliente lá em cima)
  // — a profissional anexa aqui quando manda a parte da Renascer pra clínica. Isso NÃO marca
  // "repassado" sozinho: fica só "aguardando conferência" (repasseSolicitadoEm preenchido) até
  // o dono conferir o comprovante e confirmar de verdade — só aí "repassado" vira true.
  repasseSolicitadoEm        DateTime?
  repasseComprovanteBase64   String?   @db.Text
  repasseComprovanteMimeType String?
  repasseValorInformado      Float?    // valor que a IA leu (ou a profissional digitou) no comprovante do repasse
  repasseReconhecidoPorIA    Boolean   @default(false)

  comprovanteUrl String?
  comprovanteBase64   String?   @db.Text // conteúdo real do comprovante, guardado pra poder ver depois
  comprovanteMimeType String?
  reconhecidoPorIA Boolean      @default(false)
  dadosBrutosIA    String?      @db.Text // resposta crua da IA (auditoria)

  data           DateTime       @default(now())
  observacao     String?

  // Fase 59 — pagamento parcial: quando o cliente paga só parte do valor combinado agora (ex:
  // metade de um pacote de R$120) e completa depois. valorTotal acima continua sendo só o que
  // entrou de fato NESSE lançamento (o repasse — valorProfissional/valorRenascer — também
  // continua calculado só em cima disso, igual sempre foi); valorPacoteTotal guarda o valor
  // CHEIO combinado, só quando é maior que o que já foi pago. Pendente = valorPacoteTotal -
  // valorTotal, enquanto quitadoEm estiver vazio. Quando o restante é pago, isso NÃO edita este
  // registro (cada lançamento financeiro continua um registro imutável) — cria-se uma segunda
  // transação (o complemento, com seu próprio repasse) referenciando esta por complementoDeId, e
  // só então quitadoEm é marcado aqui.
  valorPacoteTotal Float?
  quitadoEm        DateTime?
  complementoDeId  String?
  complementoDe    TransacaoFinanceira?  @relation("ComplementoPagamento", fields: [complementoDeId], references: [id])
  complementos     TransacaoFinanceira[] @relation("ComplementoPagamento")

  criadoEm       DateTime       @default(now())

  @@index([profissionalId])
  @@index([clienteId])
  @@index([data])
  @@index([recebidoPor, repassado])
  @@index([origem])
  @@index([complementoDeId])
  @@map("transacoes_financeiras")
}

// ---------- RELATÓRIOS DE CLIENTE ----------

model RelatorioCliente {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id])

  titulo         String
  conteudo       String       @db.Text
  visivelParaCliente Boolean  @default(false)

  criadoEm       DateTime     @default(now())

  @@index([clienteId])
  @@index([profissionalId])
  @@map("relatorios_cliente")
}

// ---------- COMUNICAÇÃO ----------

// Chat profissional <-> cliente (item 3 do profissional / itens 8,9 do cliente)
model MensagemInterna {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation("MensagensDoProfissional", fields: [profissionalId], references: [id])
  clienteId      String
  cliente        Cliente      @relation("MensagensDoCliente", fields: [clienteId], references: [id])

  autor          Role         // PROFISSIONAL ou CLIENTE
  texto          String       @db.Text
  tipo           String       @default("mensagem") // "mensagem" | "recado_diario" | "checkin"

  lida           Boolean      @default(false)
  criadoEm       DateTime     @default(now())

  @@index([clienteId])
  @@index([profissionalId])
  @@map("mensagens_internas")
}

// Recado do profissional pro dia do cliente (item 8 do cliente)
model RecadoDiario {
  id         String   @id @default(cuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  texto      String   @db.Text
  data       DateTime @default(now())

  @@index([clienteId])
  @@map("recados_diarios")
}

// Diário de humor do cliente (item 9 do cliente) — opcional, todo dia
model CheckinDiario {
  id         String   @id @default(cuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  humor      HumorDia
  nota       String?  @db.Text
  tarefaFeita Boolean?
  data       DateTime @default(now())

  @@index([clienteId])
  @@map("checkins_diarios")
}

// Mensagem genérica (suporte, sistema)
model Mensagem {
  id         String   @id @default(cuid())
  remetenteId String
  remetente   User    @relation("MensagensEnviadas", fields: [remetenteId], references: [id])
  ticketId    String?
  ticket      TicketSuporte? @relation(fields: [ticketId], references: [id])
  texto       String  @db.Text
  anexoUrl    String?
  criadoEm    DateTime @default(now())

  @@index([ticketId])
  @@map("mensagens")
}

// Suporte / chat com atendente-psicólogo / escalonamento pra gerência (item 7 e 19)
model TicketSuporte {
  id          String        @id @default(cuid())
  clienteId   String
  cliente     Cliente       @relation(fields: [clienteId], references: [id])
  assunto     String
  status      StatusSuporte @default(ABERTO)
  escalonadoGerencia Boolean @default(false)
  mensagens   Mensagem[]

  criadoEm    DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("tickets_suporte")
}

// ---------- TAREFAS DE APOIO ----------
// Biblioteca de tarefas por tema (item 17) — apoio, nunca diagnóstico

model Tarefa {
  id             String     @id @default(cuid())
  criadaPorId    String?
  criadaPor      Profissional? @relation("TarefasCriadasPeloProfissional", fields: [criadaPorId], references: [id])

  tema           TemaTarefa
  titulo         String
  descricao      String     @db.Text
  publica        Boolean    @default(true) // aparece na biblioteca geral

  atribuicoes    TarefaCliente[]
  criadoEm       DateTime   @default(now())

  @@map("tarefas")
}

model TarefaCliente {
  id         String   @id @default(cuid())
  tarefaId   String
  tarefa     Tarefa   @relation(fields: [tarefaId], references: [id])
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  concluida  Boolean  @default(false)
  atribuidoEm DateTime @default(now())
  concluidoEm DateTime?

  @@index([clienteId])
  @@index([tarefaId])
  @@map("tarefas_cliente")
}

// ---------- NOTIFICAÇÕES ----------

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo    String
  mensagem  String
  tipo      String   // "renovacao" | "pendencia" | "tarefa" | "financeiro" | "sistema"
  lida      Boolean  @default(false)
  // Fase 57 — "a que registro esse aviso se refere", pra abrir direto na ficha/comprovante
  // específico em vez de só trocar de aba. referenciaTipo é "CLIENTE" (abre a ficha desse
  // cliente) ou "TRANSACAO" (abre o comprovante dessa transação); referenciaId é o id do
  // registro. Os dois ficam null em avisos sem um registro único (ex: resumo diário com vários
  // clientes) — nesse caso o clique continua só trocando de aba, como já era antes.
  referenciaTipo String?
  referenciaId   String?
  criadoEm  DateTime @default(now())

  @@index([userId])
  @@map("notificacoes")
}

// Inscrição de notificação push de UM aparelho de UM usuário — cada pessoa pode ter mais de um
// aparelho inscrito (celular + computador, por exemplo), por isso é uma tabela separada e não um
// campo único no User. "endpoint" é o identificador único que o navegador/aparelho gera pra essa
// inscrição; "p256dh"/"auth" são as chaves de criptografia exigidas pelo protocolo Web Push.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  criadoEm  DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------- FINANÇAS PESSOAIS (privado, só quem é DONO vê — isolado do resto do sistema:
// nenhuma dessas tabelas se relaciona com cliente/profissional/agendamento/transação da clínica) ----------

enum TipoLancamentoPessoal {
  RECEITA
  DESPESA
}

// Categoria fixa de onde veio (receita) ou pra onde vai (despesa) o dinheiro. "OUTROS" sempre
// libera o campo de descrição livre pra digitar o que for.
enum CategoriaLancamentoPessoal {
  TURBINE
  RENASCER
  ATENDIMENTO
  CARTAO
  CASA
  ALIMENTOS
  FARMACIA
  ESPOSA
  FILHOS
  PENSAO
  PESSOA
  OUTROS
}

model LancamentoPessoal {
  id             String                     @id @default(cuid())
  tipo           TipoLancamentoPessoal
  categoria      CategoriaLancamentoPessoal
  descricao      String?                    // texto livre — obrigatório na prática quando categoria = OUTROS
  pessoa         String?                    // pra quem devo (categoria PESSOA, ou qualquer despesa com nome)
  valor          Float
  parcelaAtual   Int?                       // ex: parcela 2
  totalParcelas  Int?                       // de um total de 6
  dataVencimento DateTime?                  // só despesa — quando programar pra pagar
  dataPagamento  DateTime?                  // preenchido = já foi pago
  observacao     String?                    @db.Text
  criadoEm       DateTime                   @default(now())
  atualizadoEm   DateTime                   @updatedAt

  @@map("lancamentos_pessoais")
}

model MetaPessoal {
  id         String    @id @default(cuid())
  titulo     String
  valorMeta  Float
  valorAtual Float     @default(0)
  dataAlvo   DateTime?
  criadoEm   DateTime  @default(now())

  @@map("metas_pessoais")
}

// Poupança pessoal — cada linha é um aporte (positivo) ou uma retirada (negativo); o total é a
// soma de tudo, sem precisar guardar um "saldo" solto que pode dessincronizar.
model PoupancaAportePessoal {
  id         String   @id @default(cuid())
  valor      Float
  observacao String?
  data       DateTime @default(now())

  @@map("poupanca_aportes_pessoais")
}

// Anotações rápidas / lista do que está faltando (casa, trabalho, bebê, mercado etc) — fica do
// lado financeiro só porque é onde ele decide o que comprar, mas não é lançamento de dinheiro.
model NotaPessoal {
  id        String   @id @default(cuid())
  texto     String
  local     String?  // "Casa" | "Trabalho" | "Bebê" | livre
  resolvido Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@map("notas_pessoais")
}

// ---------- RENASCER IA (etapa 1 — base grátis) ----------
// App de IA (Claude) dentro do mesmo sistema, aberto a qualquer pessoa (não só cliente da
// clínica), separado do resto da gestão. Ver especificação completa no documento de planejamento
// do projeto (claude/renascer-ia-especificacao.md). A conversa é dado sensível (LGPD): nunca
// aparece pra dono, atendente ou profissional — só quem conversou acessa a própria conversa.

enum AutorMensagemIA {
  USUARIO
  IA
}

// Uma linha por mensagem (da pessoa ou da IA) — a conversa de cada usuário é só a lista das
// próprias linhas dele em ordem de data, sem precisar de um modelo "Conversa" à parte.
model ConversaIA {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  autor          AutorMensagemIA
  texto          String          @db.Text
  sinalizouCrise Boolean         @default(false) // true quando essa mensagem (da pessoa) acionou o cartão de crise
  criadoEm       DateTime        @default(now())

  @@index([userId, criadoEm])
  @@map("conversas_ia")
}

// Configuração única das travas de custo (uma linha só, id fixo "config"), editável pelo Dono no
// painel "Renascer IA". gastoMesAtualReais soma uma estimativa a cada mensagem respondida pela IA;
// zera sozinho quando mesReferencia (ex: "2026-10") não bate mais com o mês atual.
model ConfiguracaoIA {
  id                      String   @id @default("config")
  tetoMensalReais         Float    @default(150)
  limiteGratisDia         Int      @default(15)
  limiteGratisDiaReduzido Int      @default(5) // vale pro grátis quando o teto mensal é atingido
  limiteAssinanteDia      Int      @default(100)
  gastoMesAtualReais      Float    @default(0)
  mesReferencia           String   @default("")
  atualizadoEm            DateTime @updatedAt

  @@map("configuracao_ia")
}

// ---------- Formulários (pesquisas com link público) ----------
// Categoria nova pedida pelo Elismael: o Dono cria um formulário (ex: "Estudo de clima"), o
// sistema gera um link único que pode ser mandado pra qualquer pessoa (profissional ou cliente,
// não precisa ter login no sistema), ela preenche nome, e-mail e as respostas, e ao enviar isso
// aparece listado pro Dono dentro do formulário. Pensado pra funcionar como pesquisa de
// satisfação/clima — simples, só o essencial pra essa primeira entrega.

enum TipoPerguntaFormulario {
  TEXTO_CURTO // resposta de uma linha
  TEXTO_LONGO // resposta de texto livre, várias linhas
  MULTIPLA_ESCOLHA // escolhe uma entre as opções cadastradas (campo "opcoes")
  ESCALA // nota numérica (ex: 0 a 10, tipo NPS) — faixa guardada no campo "opcoes"
}

model Formulario {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String?  @db.Text // texto de introdução mostrado antes das perguntas (opcional)
  linkToken   String   @unique @default(cuid()) // usado na URL pública, ex: /formularios/{linkToken}
  ativo       Boolean  @default(true) // desativar fecha o link sem apagar as respostas já recebidas
  criadoPorId String?
  criadoPor   User?    @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now())

  perguntas PerguntaFormulario[]
  respostas RespostaFormulario[]

  @@index([criadoPorId])
  @@map("formularios")
}

model PerguntaFormulario {
  id           String                 @id @default(cuid())
  formularioId String
  formulario   Formulario             @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  ordem        Int
  texto        String
  tipo         TipoPerguntaFormulario
  opcoes       String? // MULTIPLA_ESCOLHA: lista separada por "|"; ESCALA: "min-max" (ex: "0-10")
  obrigatoria  Boolean                @default(true)

  @@index([formularioId])
  @@map("perguntas_formulario")
}

// Uma linha por pessoa que respondeu. As respostas em si ficam num único campo de texto (JSON
// com { perguntaId: resposta }) em vez de uma tabela à parte — suficiente pro volume esperado
// (pesquisas, não um formulário de uso diário em massa) e mais simples de listar pro Dono.
model RespostaFormulario {
  id               String     @id @default(cuid())
  formularioId     String
  formulario       Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  nomeRespondente  String
  emailRespondente String
  respostasJson    String     @db.Text
  enviadoEm        DateTime   @default(now())

  @@index([formularioId])
  @@map("respostas_formulario")
}

// ---------- "MEU DIA" (Fase 30) — checklist diário, registros de marketing/equipe/decisões,
// fechamento de caixa e metas do trimestre, pros 3 logins de gestão (Dono, Atendente,
// Profissional). Cada papel vê sua própria versão (ver histórico do sistema pra entender o
// recorte de cada um): o Dono vê o painel completo; Atendente e Profissional veem só o que já é
// delas em outras partes do sistema, nunca o financeiro consolidado da clínica.
//
// Os "criadoPorId" abaixo são de propósito um campo solto (sem relação formal do Prisma com
// User), do mesmo jeito que `Agendamento.reagendadoDe` já funciona nesse schema — guarda só o id,
// sem precisar tocar nos modelos User/Profissional existentes pra abrir essa categoria nova.

// Conclusão de um item de checklist — serve tanto pro checklist DIÁRIO ("Hoje", data preenchida
// com a meia-noite do dia) quanto pro checklist PERMANENTE ("Implantação", data nula, marca uma
// vez só e nunca mais reaparece). O "itemChave" é fixo, definido no código de cada painel.
model ChecklistConclusao {
  id          String    @id @default(cuid())
  userId      String
  itemChave   String
  data        DateTime? // null = item permanente (implantação); preenchido = dia específico (meia-noite)
  concluidoEm DateTime  @default(now())

  @@unique([userId, itemChave, data])
  @@index([userId, data])
  @@map("checklist_conclusoes")
}

// Registro de ação de marketing do dia (post, stories, resposta a comentário/DM, avaliação
// recebida) — o Dono e a Atendente podem registrar. Alimenta o indicador "ações de marketing no
// mês" dentro de Meu dia.
model RegistroMarketing {
  id          String                @id @default(cuid())
  criadoPorId String
  tipo        TipoRegistroMarketing
  descricao   String                @db.Text
  link        String?
  data        DateTime              @default(now())

  @@index([criadoPorId])
  @@index([data])
  @@map("registros_marketing")
}

// Anotação do Dono sobre a gestão de uma profissional (alinhamento, feedback, dificuldade,
// treinamento) — só o Dono registra e vê.
model RegistroPessoas {
  id             String              @id @default(cuid())
  criadoPorId    String
  profissionalId String
  tipo           TipoRegistroPessoas
  anotacao       String              @db.Text
  data           DateTime            @default(now())

  @@index([criadoPorId])
  @@index([profissionalId])
  @@map("registros_pessoas")
}

// Diário de decisões do Dono — registro livre de decisões/ideias importantes do dia a dia da
// gestão, só dele.
model DecisaoRegistro {
  id          String   @id @default(cuid())
  criadoPorId String
  texto       String   @db.Text
  data        DateTime @default(now())

  @@index([criadoPorId])
  @@map("decisoes_registro")
}

// Movimento de caixa que NÃO é pagamento de cliente (isso já é a TransacaoFinanceira que existe
// desde o início) — gasto com anúncio, aluguel, material, ou qualquer outra entrada/saída solta
// que o Dono lança no Fechamento de caixa. "canalOrigem" só é preenchido numa saída de categoria
// "Anúncio", pra permitir calcular custo por canal (CAC/ROI) depois.
model MovimentoCaixa {
  id          String             @id @default(cuid())
  tipo        TipoMovimentoCaixa
  categoria   String
  valor       Float
  descricao   String?
  canalOrigem CanalOrigem?
  criadoPorId String
  data        DateTime           @default(now())

  @@index([data])
  @@index([tipo])
  @@map("movimentos_caixa")
}

// Conferência do Fechamento de caixa de um dia: quanto o sistema calculou (transações de
// clientes recebidas pela clínica + movimentos de caixa) vs. o saldo informado do banco/Pix. Uma
// linha por dia (upsert quando o Dono conferir de novo o mesmo dia).
model ConferenciaCaixa {
  id                  String   @id @default(cuid())
  data                DateTime @unique
  saldoSistema        Float
  saldoBancoInformado Float
  diferenca           Float
  observacao          String?
  criadoPorId         String
  criadoEm            DateTime @default(now())

  @@map("conferencias_caixa")
}

// Meta do TRIMESTRE da clínica (diferente de MetaPessoal, que é a finança pessoal do Elismael) —
// ex: faturamento do trimestre, novos clientes, redução de churn. valorAtual é atualizado
// manualmente pelo Dono (não calculado sozinho, pra ele poder ajustar o que achar certo).
model MetaTrimestre {
  id           String   @id @default(cuid())
  titulo       String
  trimestre    String // ex: "2026-T4"
  unidade      String   @default("reais") // "reais" | "numero" | "percentual"
  valorMeta    Float
  valorAtual   Float    @default(0)
  observacao   String?
  criadoPorId  String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([trimestre])
  @@map("metas_trimestre")
}

// Configuração financeira da CLÍNICA (separada da ConfiguracaoIA e das finanças pessoais do
// Elismael) — custo fixo mensal e reserva de caixa, editáveis pelo Dono — usada pros indicadores
// de ponto de equilíbrio, lucro do mês e meses de reserva. Uma linha só, id fixo "config", mesmo
// padrão da ConfiguracaoIA.
model ConfiguracaoFinanceiraClinica {
  id                   String   @id @default("config")
  custoFixoMensalReais Float    @default(0)
  reservaCaixaReais    Float    @default(0)
  atualizadoEm         DateTime @updatedAt

  @@map("configuracao_financeira_clinica")
}

// Fase 70 — custo de cada funcionário que NÃO é profissional (atendente, financeiro, ou outro
// cargo administrativo/operacional) — diferente de Profissional, que já tem seu ganho calculado
// por repasse de sessão, não por "salário fixo". Alimenta o Relatório mensal (CAC = investimento
// em anúncio + soma desses custos, dividido pelos clientes novos pagantes do mês). Guarda só o
// valor ATUAL de cada um (não um histórico mês a mês) — de propósito, pra manter simples: o
// relatório de um mês passado usa a configuração de hoje. "ativo=false" é como se desliga um
// funcionário sem perder o registro (ex: alguém que saiu), sem contar no relatório dali pra frente.
enum CargoFuncionario {
  ATENDENTE
  FINANCEIRO
  OUTRO
}

model CustoFuncionario {
  id           String           @id @default(cuid())
  nome         String
  cargo        CargoFuncionario
  valorMensal  Float
  ativo        Boolean          @default(true)
  criadoPorId  String
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@map("custos_funcionarios")
}

// ---------- Fase 71 — "Banco de Oportunidades": só o Dono vê (ver backend/src/routes/dono.js,
// que já é 100% exclusivo de DONO desde o topo do arquivo) — captura ideias/oportunidades de
// negócio (reclamação de cliente, mudança de lei, cruzamento de habilidades etc.), com um filtro
// de avaliação por nota (1 a 5 em 5 critérios, soma automática) pra decidir o que vale testar.
// Pensado pra alimentar a rotina de "Meu dia": o atalho "Registrar ideia" no Fechamento cria um
// registro rápido (só título + empresa), e a segunda-feira (dia de "Estratégia e visão" no
// rodízio do Dono) mostra as que ainda não foram avaliadas, pra ele dar as notas.

enum EmpresaOportunidade {
  ESPACO_RENASCER
  GESTOR_TRAFEGO_PAGO
  GERAL
}

enum TipoOportunidade {
  INTERNA // melhorar o que já existe
  EXTERNA // produto, mercado ou parceria novos
}

enum FonteOportunidade {
  RECLAMACAO
  INESPERADO
  MUDANCA_LEI_TECNOLOGIA
  MUDANCA_COMPORTAMENTO
  BURACO_INTERNO
  CRUZAMENTO_HABILIDADES
}

enum StatusOportunidade {
  IDEIA
  AVALIADA
  EM_TESTE
  APROVADA
  IMPLEMENTADA
  ARQUIVADA
}

model Oportunidade {
  id        String               @id @default(cuid())
  titulo    String
  descricao String?              @db.Text
  empresa   EmpresaOportunidade
  tipo      TipoOportunidade?
  fonte     FonteOportunidade?

  // Filtro de avaliação (1 a 5 cada) — ficam nulos até o Dono avaliar. pontuacaoTotal é a soma
  // das 5, recalculada no servidor toda vez que alguma nota muda (nunca confiar em soma vinda do
  // front) — guardada já pronta pra poder ordenar a listagem direto por ela, sem calcular na hora.
  notaTamanhoProblema    Int?
  notaDisposicaoPagar    Int?
  notaCapacidadeExecutar Int?
  notaCustoTestar        Int?
  notaAlinhamento        Int?
  pontuacaoTotal         Int?

  status              StatusOportunidade @default(IDEIA)
  motivoArquivamento  String?            @db.Text // só preenchido quando status = ARQUIVADA

  criadoPorId  String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@index([empresa])
  @@map("oportunidades")
}

// ---------- Fase 71 — bloco de notas de aula (pedido à parte do Banco de Oportunidades): o Dono
// assiste uma aula/curso em outra aba e quer um bloco de notas numa JANELA pequena separada do
// navegador (ver frontend/src/pages/dono/notas-popup.js, aberta via window.open), uma anotação por
// aula, identificada pelo tema. Também só o Dono (mesmo arquivo dono.js).
model AnotacaoEstudo {
  id           String   @id @default(cuid())
  tema         String
  conteudo     String   @db.Text
  criadoPorId  String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("anotacoes_estudo")
}
